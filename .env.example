# ClipStream AI - Environment Configuration
# Paste your API keys below (or configure them directly in the Web UI Settings tab)

# Google Gemini API Key (for Virality Evaluation & Title Generation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (for sub-second Whisper transcription & Llama 3 Hook Evaluation)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Default Processing Settings
DEFAULT_CLIP_MIN_DURATION=20
DEFAULT_CLIP_MAX_DURATION=60
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
